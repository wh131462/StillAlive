+        let data = try handle.read(upToCount: Int(min(64 * 1024, remaining))) ?? Data()
+        if data.isEmpty { break }
+        task.didReceive(data)
+        remaining -= Int64(data.count)
+      }
+      if remaining == 0 { finish(task, identifier: identifier) }
+      else if isTaskActive(identifier) { fail(task, identifier: identifier, code: NSURLErrorCannotDecodeContentData) }
+    } catch {
+      fail(task, identifier: identifier, error: error)
+    }
+  }
+
+  private func resolveMediaFile(_ url: URL) -> URL? {
+    guard url.scheme == Self.scheme,
+      let components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+      let value = components.queryItems?.first(where: { $0.name == "uri" })?.value,
+      let fileURL = URL(string: value),
+      fileURL.isFileURL else { return nil }
