@@ -10,3 +10,24 @@
+function handleViewCommand(result: unknown): void {
+  if (!result || typeof (result as Promise<void>).catch !== 'function') {
+    return;
+  }
+  void (result as Promise<void>).catch((error: unknown) => {
+    const message =
+      error && typeof error === 'object' && 'message' in error
+        ? String(error.message)
+        : String(error);
+    if (
+      message.includes(
+        'Unable to find the class expo.modules.webview.DomWebView view with tag'
+      ) ||
+      message.includes("Unable to find the 'DomWebView' view with tag")
+    ) {
+      return;
+    }
+    console.error(error);
+  });
+}
+
 type NativeWebViewProps = Omit<DomWebViewProps, 'containerStyle' | 'injectedJavaScriptObject'> & {
   injectedJavaScriptObject: string;
 };
