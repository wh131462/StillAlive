+    var headers = [
+      "Accept-Ranges": "bytes",
+      "Access-Control-Allow-Origin": "*",
+      "Cache-Control": "no-store",
+      "Content-Length": String(contentLength),
+      "Content-Type": mediaMimeType(url, fileURL: fileURL)
+    ]
+    if partial {
+      headers["Content-Range"] = "bytes \(range.lowerBound)-\(range.upperBound)/\(size)"
+    }
+    guard sendResponse(task, identifier: identifier, url: url, status: partial ? 206 : 200, reason: partial ? "Partial Content" : "OK", headers: headers) else { return }
+    if task.request.httpMethod?.uppercased() == "HEAD" || contentLength == 0 {
+      finish(task, identifier: identifier)
+      return
+    }
+    do {
+      let handle = try FileHandle(forReadingFrom: fileURL)
+      defer { try? handle.close() }
+      try handle.seek(toOffset: UInt64(range.lowerBound))
+      var remaining = contentLength
