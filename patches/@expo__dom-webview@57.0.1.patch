+private class MediaRangeInputStream(file: File, start: Long, private var remaining: Long) : InputStream() {
+  private val input = FileInputStream(file).apply { channel.position(start); Log.d("StillAliveMedia", "open start=$start remaining=$remaining available=${available()}") }
+
+  override fun read(): Int {
+    if (remaining <= 0) return -1
+    val value = input.read()
+    if (value >= 0) remaining -= 1
+    return value
+  }
+
+  override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+    if (remaining <= 0) return -1
+    val count = input.read(buffer, offset, minOf(length.toLong(), remaining).toInt())
+    if (count > 0) remaining -= count
+    if (count < 0) Log.d("StillAliveMedia", "eof remaining=$remaining")
+    return count
+  }
