+  private fun resolveMediaFile(uri: Uri): File? {
+    val fileUri = uri.getQueryParameter("uri")?.let(Uri::parse) ?: return null
+    if (fileUri.scheme != "file") return null
+    val file = fileUri.path?.let(::File)?.canonicalFile ?: return null
+    if (!file.isFile) return null
