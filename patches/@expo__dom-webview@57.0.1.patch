+    let manager = FileManager.default
+    var roots = [manager.temporaryDirectory]
+    for directory in [FileManager.SearchPathDirectory.documentDirectory, .libraryDirectory, .cachesDirectory, .applicationSupportDirectory] {
+      roots.append(contentsOf: manager.urls(for: directory, in: .userDomainMask))
+    }
+    let allowed = roots.map { $0.standardizedFileURL.resolvingSymlinksInPath().path }.contains { root in
+      candidate.path == root || candidate.path.hasPrefix(root + "/")
+    }
+    var isDirectory: ObjCBool = false
+    return allowed && manager.fileExists(atPath: candidate.path, isDirectory: &isDirectory) && !isDirectory.boolValue ? candidate : nil
+  }
+
+  private func mediaRange(_ header: String?, size: Int64) -> ClosedRange<Int64>? {
+    guard size >= 0 else { return nil }
+    guard let header else { return size > 0 ? 0...(size - 1) : 0...0 }
+    guard size > 0, header.hasPrefix("bytes="), !header.contains(",") else { return nil }
+    let parts = header.dropFirst("bytes=".count).split(separator: "-", maxSplits: 1, omittingEmptySubsequences: false)
+    guard parts.count == 2 else { return nil }
+    let start: Int64
+    if parts[0].isEmpty {
+      guard let suffixLength = Int64(parts[1]), suffixLength > 0 else { return nil }
+      start = max(0, size - suffixLength)
+    } else {
+      guard let value = Int64(parts[0]), value >= 0, value < size else { return nil }
+      start = value
+    }
+    let end: Int64
+    if parts[0].isEmpty || parts[1].isEmpty {
+      end = size - 1
+    } else {
+      guard let value = Int64(parts[1]) else { return nil }
+      end = min(value, size - 1)
+    }
+    return end >= start ? start...end : nil
+  }
+
+  private func mediaMimeType(_ url: URL, fileURL: URL) -> String {
+    if let value = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems?.first(where: { $0.name == "mime" })?.value,
+      value.range(of: #"^(image|audio|video)/[A-Za-z0-9.+-]+$"#, options: .regularExpression) != nil {
+      return value
+    }
+    switch fileURL.pathExtension.lowercased() {
+    case "jpg", "jpeg": return "image/jpeg"
+    case "png": return "image/png"
+    case "webp": return "image/webp"
+    case "heic", "heif": return "image/heic"
+    case "mov": return "video/quicktime"
+    case "m4v": return "video/x-m4v"
+    case "webm": return "video/webm"
+    case "mp4": return "video/mp4"
+    case "m4a": return "audio/mp4"
+    case "caf": return "audio/x-caf"
+    case "mp3": return "audio/mpeg"
+    case "wav": return "audio/wav"
+    default: return "application/octet-stream"
+    }
+  }
+
+  private func respond(_ task: WKURLSchemeTask, identifier: ObjectIdentifier, status: Int, reason: String, headers: [String: String]) {
+    guard let url = task.request.url,
+      sendResponse(task, identifier: identifier, url: url, status: status, reason: reason, headers: headers) else { return }
+    finish(task, identifier: identifier)
+  }
+
+  private func sendResponse(_ task: WKURLSchemeTask, identifier: ObjectIdentifier, url: URL, status: Int, reason: String, headers: [String: String]) -> Bool {
+    guard isTaskActive(identifier),
+      let response = HTTPURLResponse(url: url, statusCode: status, httpVersion: "HTTP/1.1", headerFields: headers) else { return false }
+    task.didReceive(response)
+    return true
+  }
+
+  private func finish(_ task: WKURLSchemeTask, identifier: ObjectIdentifier) {
+    guard takeTask(identifier) else { return }
+    task.didFinish()
+  }
+
+  private func fail(_ task: WKURLSchemeTask, identifier: ObjectIdentifier, code: Int) {
+    fail(task, identifier: identifier, error: NSError(domain: NSURLErrorDomain, code: code))
+  }
+
+  private func fail(_ task: WKURLSchemeTask, identifier: ObjectIdentifier, error: Error) {
+    guard takeTask(identifier) else { return }
+    task.didFailWithError(error)
+  }
+
+  private func setTask(_ identifier: ObjectIdentifier, active: Bool) {
+    lock.lock()
+    if active { activeTasks.insert(identifier) } else { activeTasks.remove(identifier) }
+    lock.unlock()
+  }
+
+  private func isTaskActive(_ identifier: ObjectIdentifier) -> Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return activeTasks.contains(identifier)
+  }
+
+  private func takeTask(_ identifier: ObjectIdentifier) -> Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return activeTasks.remove(identifier) != nil
+  }
+}
