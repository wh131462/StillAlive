+    if (requestedRange != null && range == null) return mediaErrorResponse(416, "Range Not Satisfiable", mapOf("Content-Range" to "bytes */$size"))
+    val start = range?.first ?: 0L
+    val end = range?.second ?: (size - 1L)
+    val contentLength = if (size > 0) end - start + 1 else 0
+    val partial = requestedRange != null
+    Log.d("StillAliveMedia", "serve ${request.url.path} requestedRange=${requestedRange ?: "none"} start=$start length=$contentLength")
+    val headers = mutableMapOf(
+      "Accept-Ranges" to "bytes",
+      "Access-Control-Allow-Origin" to "*",
+      "Cache-Control" to "no-store",
+      "Content-Length" to contentLength.toString()
+    )
