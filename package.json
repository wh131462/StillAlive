{
  "name": "stillalive",
  "version": "0.0.0",
  "private": true,
  "description": "还活着 - 多端打卡应用",
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=@stillalive/server",
    "dev:web": "turbo run dev --filter=@stillalive/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @stillalive/server prisma:migrate",
    "db:studio": "pnpm --filter @stillalive/server prisma:studio",
    "db:seed": "pnpm --filter @stillalive/server db:seed",
    "setup": "pnpm install && pnpm db:up && sleep 3 && pnpm db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
