{
  "name": "still-alive",
  "version": "1.0.6",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @still-alive/mobile dev",
    "dev:android": "pnpm --filter @still-alive/mobile dev:android",
    "dev:portal": "pnpm --filter @still-alive/portal dev",
    "build": "turbo run build",
    "build:apk": "./build-apk.sh",
    "release": "node ./scripts/release.mjs",
    "release:testflight": "cd apps/mobile && npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "2.10.5",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@expo/dom-webview@57.0.1": "patches/@expo__dom-webview@57.0.1.patch"
    }
  }
}
