generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  nickname     String?
  avatarUrl    String?  @map("avatar_url")
  passwordHash String?  @map("password_hash")

  wechatOpenid     String? @unique @map("wechat_openid")
  wechatUnionid    String? @unique @map("wechat_unionid")
  wechatMiniOpenid String? @unique @map("wechat_mini_openid")
  appleId          String? @unique @map("apple_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checkIns          CheckIn[]
  persons           Person[]
  personGroups      PersonGroup[]
  stories           Story[]
  resonances        Resonance[]
  deathConfirmation DeathConfirmation?
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  device    String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CheckIn {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  date          String
  isRetroactive Boolean  @default(false) @map("is_retroactive")
  content       String?
  photoUrl      String?  @map("photo_url")
  moodTag       String?  @map("mood_tag")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("check_ins")
}

model Person {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  gender        String?
  birthday      String?
  birthdayLunar Boolean  @default(false) @map("birthday_lunar")
  photoUrl      String?  @map("photo_url")
  mbti          String?
  themeColor    String   @default("#C24D2C") @map("theme_color")
  impression    String?
  groupId       String?  @map("group_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          PersonGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  importantDates ImportantDate[]
  sharedMemories SharedMemory[]

  @@index([userId])
  @@map("persons")
}

model PersonGroup {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  name     String
  isPreset Boolean @default(false) @map("is_preset")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  persons Person[]

  @@unique([userId, name])
  @@map("person_groups")
}

model ImportantDate {
  id       String  @id @default(cuid())
  personId String  @map("person_id")
  date     String
  label    String
  isLunar  Boolean @default(false) @map("is_lunar")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("important_dates")
}

model SharedMemory {
  id        String   @id @default(cuid())
  personId  String   @map("person_id")
  content   String
  date      String?
  createdAt DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("shared_memories")
}

model Story {
  id                  String    @id @default(cuid())
  title               String?
  content             String
  approximateDate     String?   @map("approximate_date")
  category            String?
  hasSensitiveContent Boolean   @default(false) @map("has_sensitive_content")
  resonanceCount      Int       @default(0) @map("resonance_count")
  authorUserId        String?   @map("author_user_id")
  contactEmail        String?   @map("contact_email")
  status              String    @default("pending")
  createdAt           DateTime  @default(now()) @map("created_at")
  publishedAt         DateTime? @map("published_at")

  author     User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  resonances Resonance[]

  @@index([status])
  @@index([authorUserId])
  @@map("stories")
}

model Resonance {
  id        String   @id @default(cuid())
  storyId   String   @map("story_id")
  userId    String?  @map("user_id")
  deviceId  String?  @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([storyId, userId])
  @@unique([storyId, deviceId])
  @@map("resonances")
}

model DeathConfirmation {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  triggerDays    Int     @default(7) @map("trigger_days")
  emergencyEmail String  @map("emergency_email")
  enabled        Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("death_confirmations")
}
