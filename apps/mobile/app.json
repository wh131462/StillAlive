{
  "expo": {
    "name": "仍在",
    "slug": "still-alive",
    "scheme": "stillalive",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#EEF0E8",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D6B49"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "app"
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "允许“仍在”使用面容 ID 快捷解锁本机密码本。",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D6B49"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许“仍在”拍摄照片或视频，添加到本地记录或相册中；照片也可用于头像。",
          "photosPermission": "允许“仍在”选择照片或视频，添加到本地记录或相册中；照片也可用于头像。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许“仍在”获取你当前所在的位置，用于记录地点和打卡城市。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许“仍在”使用麦克风，将语音保存到你的本地记录中。",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "9",
      "bundleIdentifier": "com.eternalheart.stillalive",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eternalheart.stillalive",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1D6B49"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10d061f3-30ec-4fd5-bde1-45ccb235661d"
      }
    },
    "owner": "eternalheart"
  }
}
