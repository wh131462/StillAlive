{
  "expo": {
    "name": "仍在",
    "slug": "still-alive",
    "scheme": "stillalive",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#EEF0E8",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF0E8"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D6B49"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许“仍在”选择照片，添加到你的本地日记中。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.stillalive.mobile"
    },
    "android": {
      "package": "app.stillalive.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#1D6B49"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
