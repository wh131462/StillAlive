{
  "name": "@still-alive/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform ios --output-dir dist/ios && EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No mobile tests yet'",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@eternalheart/react-file-preview": "1.6.1",
    "@expo/dom-webview": "^57.0.1",
    "@still-alive/backup": "workspace:*",
    "@still-alive/core": "workspace:*",
    "@still-alive/storage": "workspace:*",
    "@still-alive/tokens": "workspace:*",
    "@still-alive/types": "workspace:*",
    "dompurify": "^3.4.12",
    "expo": "57.0.7",
    "expo-audio": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-image-picker": "57.0.5",
    "expo-modules-autolinking": "~57.0.8",
    "expo-notifications": "~57.0.6",
    "expo-router": "57.0.7",
    "expo-sharing": "57.0.6",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "^57.0.1",
    "expo-system-ui": "~57.0.1",
    "fflate": "^0.8.3",
    "marked": "^18.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tyme4ts": "^1.5.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/turndown": "^5.0.6",
    "typescript": "~6.0.3"
  }
}
