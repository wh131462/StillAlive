{
  "name": "@still-alive/mobile",
  "version": "1.0.6",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:android": "./scripts/dev-android.sh",
    "build": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform ios --output-dir dist/ios && EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No mobile tests yet'",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@epubjs-react-native/core": "^1.4.7",
    "@expo-google-fonts/material-symbols": "0.4.41",
    "@expo/dom-webview": "^57.0.1",
    "@noble/hashes": "1.8.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@still-alive/backup": "workspace:*",
    "@still-alive/core": "workspace:*",
    "@still-alive/storage": "workspace:*",
    "@still-alive/tokens": "workspace:*",
    "@still-alive/types": "workspace:*",
    "dompurify": "^3.4.12",
    "expo": "57.0.7",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-image-picker": "57.0.5",
    "expo-location": "57.0.7",
    "expo-modules-autolinking": "~57.0.8",
    "expo-notifications": "~57.0.6",
    "expo-router": "57.0.7",
    "expo-screen-capture": "57.0.1",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "57.0.6",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "^57.0.1",
    "expo-system-ui": "~57.0.1",
    "fflate": "^0.8.3",
    "marked": "^18.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "^7.0.5",
